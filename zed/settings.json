// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
//
// Uses settings from https://github.com/jellydn/zed-101-setup
{
  "agent": {
    "profiles": {},
    "button": true,
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
      "enable_thinking": true,
      "effort": "high",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "cli_default_open_behavior": "new_window",
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "buffer_font_family": "GeistMono Nerd Font Mono",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "icon_theme": "Catppuccin Frappé",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "GitHub Dark Dimmed",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "pytest-language-server", "ruff"],
      "code_actions_on_format": {
        "source.organizeImport.ruff": true,
      },
      "formatter": {
        "language_server": { "name": "ruff" },
      },
      "format_on_save": "on",
    },
  },
  "terminal": {
    "env": {
      "EDITOR": "zed --wait",
    },
  },
  "format_on_save": "on",
  // File scan exclusions, hide on the file explorer and search
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // above is default from Zed
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules",
    "**/__pycache__",
    "**/.ruff_cache",
    "**/.pytest_cache",
    "**/.mypy_cache",
  ],
  "project_panel": {
    "git_status": true,
    "button": true,
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "tabs": { "show_diagnostics": "errors" },
  "tab_bar": { "show": true },
  "which_key": { "delay_ms": 500, "enabled": true },
  "git_panel": { "tree_view": true },
}
